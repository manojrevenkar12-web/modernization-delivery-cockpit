 "findings": [
  {
   "id": "F01",
   "kind": "risk",
   "severity": "high",
   "title": "OrderService.insertOrder writes 3 collections in one transaction",
   "evidence": "@Transactional; writes items, orders, sequences via updateInventoryQuantity, insertOrder, insertOrderStatus, insertLineItem, getSequence, updateSequence",
   "action": "Needs a multi-document transaction (replica set, as on Atlas) or a redesign so the write lands in one document; agree which with the customer architect",
   "statements": [
    "updateInventoryQuantity",
    "insertOrder",
    "insertOrderStatus",
    "insertLineItem",
    "updateSequence"
   ],
   "data": false
  },
  {
   "id": "F02",
   "kind": "risk",
   "severity": "high",
   "title": "Order ids come from a read-then-write sequence",
   "evidence": "OrderService reads getSequence then writes updateSequence with no lock: two concurrent orders can get the same id",
   "action": "Replace with an atomic findOneAndUpdate($inc); confirm the id format stays the same for the customer's reports",
   "statements": [
    "getSequence",
    "updateSequence"
   ],
   "data": false
  },
  {
   "id": "F03",
   "kind": "issue",
   "severity": "high",
   "title": "Passwords are stored in plain text",
   "evidence": "SIGNON.PASSWORD is varchar(25), compared directly in SQL",
   "action": "Out of scope for a like-for-like migration: raise with the customer's security lead and agree a hashing change as a separate, tested step",
   "statements": [
    "getAccountByUsername",
    "getAccountByUsernameAndPassword",
    "updateSignon",
    "insertSignon"
   ],
   "data": false
  },
  {
   "id": "F04",
   "kind": "risk",
   "severity": "medium",
   "title": "6 reads use inner joins that hide rows",
   "evidence": "e.g. getAccountByUsername, getAccountByUsernameAndPassword, getItem, getItemListByProduct: a missing profile, banner, status or inventory row drops the result",
   "action": "Keep the legacy behaviour unless the customer decides otherwise; parity tests pin it",
   "statements": [
    "getAccountByUsername",
    "getAccountByUsernameAndPassword",
    "getItemListByProduct",
    "getItem",
    "getOrder",
    "getOrdersByUsername"
   ],
   "data": false
  },
  {
   "id": "F05",
   "kind": "risk",
   "severity": "medium",
   "title": "Search passes user input into SQL LIKE",
   "evidence": "searchProductList: % and _ typed by a user are wildcards",
   "action": "Translate LIKE exactly (anchored regex on a lower-cased copy of the name, indexed); flag the wildcard behaviour to the product owner",
   "statements": [
    "searchProductList"
   ],
   "data": false
  },
  {
   "id": "F06",
   "kind": "risk",
   "severity": "medium",
   "title": "Money columns are DECIMAL",
   "evidence": "listprice, unitcost, unitprice, totalprice are decimal(10,2)",
   "action": "Store as Decimal128, never as double; reconcile totals after the data migration",
   "statements": [],
   "data": true
  },
  {
   "id": "F07",
   "kind": "risk",
   "severity": "low",
   "title": "Child tables have no foreign keys",
   "evidence": "lineitem, orderstatus, inventory can hold orphan rows",
   "action": "Count orphans in the customer's production copy before migration; agree whether to drop or quarantine them",
   "statements": [],
   "data": true
  }
 ],
